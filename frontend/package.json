{
  "name": "systeminfo-viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start-dev": "concurrently \"vite\" \"chromium --kiosk --incognito --window-position=0,0 --app=http://localhost:5173 --remote-debugging-port=9222\"",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@googlemaps/google-maps-services-js": "^3.4.2",
    "@lucide/vue": "^1.70.0",
    "@tailwindcss/vite": "^4.3.3",
    "axios": "^1.21.0",
    "chart.js": "^4.6.1",
    "tailwind": "^2.3.1",
    "vue": "^3.5.44",
    "vue-chartjs": "^5.3.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.6",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13"
  }
}
